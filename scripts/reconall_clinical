#!/bin/bash
# freesurfer_batch_clinical.sh
# Resumable batch runner for recon-all-clinical (FreeSurfer 8.1.0)

export FREESURFER_HOME=/home/ajay/Documents/freesurfer-8/freesurfer/8.1.0
source $FREESURFER_HOME/SetUpFreeSurfer.sh

INPUT_DIR="./freesurfer_inputs/ECT"
# Output base folder
OUTPUT_BASE="./freesurfer_outputs/ECT_clinical"
SUBJECTS_DIR="./freesurfer_outputs/ECT_clinical"
mkdir -p $SUBJECTS_DIR

THREADS=6

echo "=============================="
echo " FreeSurfer Batch (Clinical)  "
echo " INPUT_DIR: $INPUT_DIR"
echo " SUBJECTS_DIR: $SUBJECTS_DIR"
echo " THREADS: $THREADS"
echo "=============================="

for file in "$INPUT_DIR"/*.nii.gz; do
    subj=$(basename "$file" .nii.gz)
    subj_id="${subj}.tp1"

    echo ""
    echo ">>> Checking subject: $subj_id"

    SUBJECT_DIR_PATH="$SUBJECTS_DIR/$subj_id"

    # 1. If subject does NOT exist → run synthseg
    if [ ! -d "$SUBJECT_DIR_PATH" ]; then
        echo ">>> New subject detected — running SynthSeg"
        recon-all-clinical.sh -i "$file" -subjid "$subj_id" -threads "$THREADS" \
        -sdir "$SUBJECTS_DIR"
        #recon-all-clinical.sh INPUT_SCAN SUBJECT_ID THREADS [SUBJECT_DIR]
    fi

    echo ">>> Done with $subj_id"

done

echo "=============================="
echo "       ALL SUBJECTS DONE      "
echo "=============================="
